{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug native_sim (Zephyr)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/apps/drive/build/sim/zephyr/zephyr.exe",
            "args": [],
            "cwd": "${workspaceFolder}/apps/drive/build/sim",
            "stopAtEntry": false,
            "externalConsole": false,
            "preLaunchTask": "Zephyr: build sim",
            "MIMode": "gdb",
            "miDebuggerPath": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "Debug Jacobi (Zephyr)",
            "type": "cortex-debug",
            "request": "launch",
            "cwd": "${workspaceFolder}/apps/drive/build/jacobi",
            "executable": "${workspaceFolder}/apps/drive/build/jacobi/zephyr/zephyr.elf",
            "device": "STM32H743VI",
            "interface": "swd",
            "armToolchainPath": "/home/alex/zephyr-sdk-1.0.1/gnu/arm-zephyr-eabi/bin",
            "runToEntryPoint": "main",
            "breakAfterReset": true,
            "rttConfig": {
                "enabled": true,
                "address": "auto",
                "decoders": [
                    {
                        "label": "Zephyr log",
                        "port": 0,
                        "type": "console"
                    }
                ]
            },
            "liveWatch": {
                "enabled": true,
                "samplesPerSecond": 4
            }
        },
        {
            "name": "Debug NUCLEO-H743ZI (Zephyr)",
            "type": "cortex-debug",
            "request": "launch",
            "cwd": "${workspaceFolder}/apps/drive/build/h743",
            "executable": "${workspaceFolder}/apps/drive/build/h743/zephyr/zephyr.elf",
            "preLaunchTask": "Zephyr: build h743",
            "servertype": "openocd",
            "showDevDebugOutput": "raw",
            "configFiles": [
                "${workspaceFolder}/apps/drive/boards/nucleo_h743zi_openocd.cfg"
            ],
            "device": "STM32H743ZI",
            "interface": "swd",
            "armToolchainPath": "/home/alex/zephyr-sdk-1.0.1/gnu/arm-zephyr-eabi/bin",
            "gdbPath": "/home/alex/zephyr-sdk-1.0.1/gnu/arm-zephyr-eabi/bin/arm-zephyr-eabi-gdb",
            "objdumpPath": "/usr/bin/arm-none-eabi-objdump",
            "runToEntryPoint": "main",
            "liveWatch": {
                "enabled": true,
                "samplesPerSecond": 4
            }
        }
    ]
}
