{
    "version": "2.0.0",
    "options": {
        "cwd": "/home/alex/zephyr-ws",
        "env": {
            "ZEPHYR_BASE": "/home/alex/zephyr-ws/zephyr",
            "ZEPHYR_SDK_INSTALL_DIR": "/home/alex/zephyr-sdk-1.0.1",
            "PATH": "/home/alex/zephyr-ws/.venv/bin:${env:PATH}"
        }
    },
    "tasks": [
        {
            "label": "Zephyr: build sim",
            "type": "shell",
            "command": "west build -b native_sim/native/64 unimoc/apps/drive -d unimoc/apps/drive/build/sim",
            "problemMatcher": "$gcc",
            "group": "build"
        },
        {
            "label": "Zephyr: build jacobi",
            "type": "shell",
            "command": "west build -b unimoc_jacobi unimoc/apps/drive -d unimoc/apps/drive/build/jacobi",
            "problemMatcher": "$gcc",
            "group": "build"
        },
        {
            "label": "Zephyr: build h743",
            "type": "shell",
            "command": "west build -b nucleo_h743zi unimoc/apps/drive -d unimoc/apps/drive/build/h743",
            "problemMatcher": "$gcc",
            "group": "build"
        },
        {
            "label": "Zephyr: build all",
            "dependsOn": [
                "Zephyr: build sim",
                "Zephyr: build jacobi"
            ],
            "dependsOrder": "sequence",
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Zephyr: run sim",
            "type": "shell",
            "command": "west build -d unimoc/apps/drive/build/sim -t run",
            "dependsOn": "Zephyr: build sim",
            "problemMatcher": [],
            "isBackground": false
        },
        {
            "label": "Zephyr: twister (native_sim + jacobi)",
            "type": "shell",
            "command": "west twister -T unimoc -p native_sim/native/64 -p unimoc_jacobi",
            "problemMatcher": "$gcc",
            "group": {
                "kind": "test",
                "isDefault": true
            }
        },
        {
            "label": "Zephyr: flash jacobi",
            "type": "shell",
            "command": "west flash -d unimoc/apps/drive/build/jacobi --runner openocd",
            "dependsOn": "Zephyr: build jacobi",
            "problemMatcher": []
        },
        {
            "label": "Zephyr: flash h743",
            "type": "shell",
            "command": "west flash -d unimoc/apps/drive/build/h743 --runner openocd --config unimoc/apps/drive/boards/nucleo_h743zi_openocd.cfg",
            "dependsOn": "Zephyr: build h743",
            "problemMatcher": []
        },
        {
            "label": "Zephyr: pristine build all",
            "type": "shell",
            "command": "west build -p always -b native_sim/native/64 unimoc/apps/drive -d unimoc/apps/drive/build/sim && west build -p always -b unimoc_jacobi unimoc/apps/drive -d unimoc/apps/drive/build/jacobi",
            "problemMatcher": "$gcc"
        }
    ]
}
