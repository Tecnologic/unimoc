{
	"folders": [
		{
			"name": "unimoc",
			"path": ".."
		}
	],
	"settings": {
		
		"cmake.automaticReconfigure": true,
		"cmake.copyCompileCommands": "${workspaceFolder}/compile_commands.json",
		"cmake.autoSelectActiveFolder": false,
		"clangd.arguments": [
			"--compile-commands-dir=${workspaceFolder}/app/build/bcc",
			"--background-index",
			"--completion-style=detailed",
			"--header-insertion=never",
			"--query-driver=/home/alex/zephyr-sdk-1.0.1/**/*"
		],
		"C_Cpp.intelliSenseEngine": "disabled",
		"editor.formatOnSaveMode": "modificationsIfAvailable",
		"[c]": {
			"editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd"
		},
		"[cpp]": {
			"editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd"
		},
		"[jsonc]": {
			"editor.defaultFormatter": "vscode.json-language-features"
		},
		"cmake.ctest.testExplorerIntegrationEnabled": true,
		"chat.tools.terminal.autoApprove": {
			"/^cmake\\b/": true,
			"/^ninja\\b/": true,
			"/^make\\b/": true,
			"/^ctest\\b/": true,
			"/^clang-format\\b/": true,
			"/^clang-tidy\\b/": true,
			"/^arm-zephyr-eabi-.*/": true,
			"/^west\\b/": true,
			"/^git\\s+(status|diff|log)/": true
		},
		"cmake.configureOnOpen": false,
		"VsCodeTaskButtons.showCounter": false,
		"VsCodeTaskButtons.tasks": [
			{
				"label": "$(tools) Build all",
				"task": "Zephyr: build all",
				"tooltip": "Build native_sim and BCC"
			},
			{
				"label": "$(play) Run sim",
				"task": "Zephyr: run sim",
				"tooltip": "Build and run native_sim on the host"
			},
			{
				"label": "$(beaker) Test",
				"task": "Zephyr: twister (native_sim + bcc)",
				"tooltip": "Run twister for native_sim and BCC"
			},
			{
				"label": "$(folder) Unimoc",
				"tooltip": "More Zephyr tasks",
				"tasks": [
					{ "label": "Build sim", "task": "Zephyr: build sim" },
					{ "label": "Build BCC", "task": "Zephyr: build bcc" },
					{ "label": "Flash BCC", "task": "Zephyr: flash bcc" }
				]
			}
		],
		"nrf-connect.applications": [
			"${workspaceFolder}/app"
		],
		"nrf-connect.boardRoots": [
			"${workspaceFolder}"
		],
		"nrf-connect.topdir": "/home/alex/zephyr-ws",
		"nrf-connect.toolchain.path": "/home/alex/zephyr-sdk-1.0.1",
		"nrf-connect.west.env": {
			"$base": "terminal",
			"PATH": [
				"/home/alex/zephyr-ws/.venv/bin",
				"$base"
			],
			"ZEPHYR_BASE": "/home/alex/zephyr-ws/zephyr",
			"ZEPHYR_SDK_INSTALL_DIR": "/home/alex/zephyr-sdk-1.0.1"
		},
		"nrf-connect.debugging.bindings": {
			"${workspaceFolder}/app/build/sim": "Debug native_sim (Zephyr)",
			"${workspaceFolder}/app/build/bcc": "Debug BCC (Zephyr)"
		}
	}
}
