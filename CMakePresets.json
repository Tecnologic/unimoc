{
    "version": 6,
    "cmakeMinimumRequired": {
      "major": 4,
      "minor": 0,
      "patch": 0
    },
    "configurePresets": [
      {
        "name": "BatteryCaseController Debug",
        "displayName": "Debug Build for Battery Case Controller",
        "description": "Build Debug firmware for STM32G473 using ARM GCC toolchain for Battery Case Controller",
        "generator": "Ninja",
        "binaryDir": "${sourceDir}/build/batterycasecontroller-debug",
        "toolchainFile": "${sourceDir}/cmake/ToolChain.cmake",
        "environment": {
            "GCC_PATH": "/usr/bin"
        },
        "cacheVariables": {
            "CMAKE_BUILD_TYPE": "Debug",
            "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
            "HARDWARE_DIRECTORY": "${sourceDir}/hardware/batterycasecontroller",
            "MODM_DBG_UI": "tui",
            "CYMON_BUILD_TESTS": "OFF"
          }
      },
      {
        "name": "BatteryCaseController Release",
        "displayName": "Release Build for Battery Case Controller",
        "description": "Build Release firmware for STM32G473 using ARM GCC toolchain for Battery Case Controller",
        "generator": "Ninja",
        "binaryDir": "${sourceDir}/build/batterycasecontroller-release",
        "toolchainFile": "${sourceDir}/cmake/ToolChain.cmake",
        "environment": {
            "GCC_PATH": "/usr/bin"
        },
        "cacheVariables": {
            "CMAKE_BUILD_TYPE": "MinSizeRel",
            "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
            "HARDWARE_DIRECTORY": "${sourceDir}/hardware/batterycasecontroller",
            "MODM_DBG_UI": "tui",
            "CYMON_BUILD_TESTS": "OFF"
          }
      },
      {
        "name": "Hosted build with tests",
        "displayName": "Hosted build with tests",
        "description": "Build and run tests on host (e.g. x86_64 Linux or Windows)",
        "generator": "Ninja",
        "binaryDir": "${sourceDir}/build/hosted",
        "cacheVariables": {
          "CMAKE_BUILD_TYPE": "Debug",
          "ENABLE_TESTS": "ON",
          "CYMON_BUILD_TESTS": "ON",
          "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
          "CMAKE_CXX_COMPILER": "clang++",
          "CMAKE_C_COMPILER_WORKS": "ON",
          "CMAKE_CXX_COMPILER_WORKS": "ON",
          "ENABLE_CLANG_TIDY": "OFF",
          "HARDWARE_DIRECTORY": "${sourceDir}/hardware/host",
          "RUNNING_ON_HOST": "ON"
        }
      },
      {
        "name": "Hosted build with tests + clang-tidy",
        "inherits": "Hosted build with tests",
        "cacheVariables": {
          "ENABLE_CLANG_TIDY": "ON"
        }
      },
      {
        "name": "Doxygen",
        "displayName": "Generate UNIMOC Doxygen documentation",
        "description": "Generate API documentation for UNIMOC-owned C++ code",
        "inherits": "Hosted build with tests",
        "binaryDir": "${sourceDir}/build/doxygen",
        "cacheVariables": {
          "ENABLE_DOXYGEN": "ON"
        }
      }
    ],
    "buildPresets": [
        {
            "name": "BatteryCaseController Debug",
            "configurePreset": "BatteryCaseController Debug",
            "displayName": "Build BatteryCaseController Debug Firmware"
        },
        {
            "name": "BatteryCaseController Release",
            "configurePreset": "BatteryCaseController Release",
            "displayName": "Build BatteryCaseController Release Firmware"
        },
        {
            "name": "Hosted build with tests",
            "configurePreset": "Hosted build with tests",
            "displayName": "Build and Test on Host"
        },
        {
          "name": "Hosted build with tests + clang-tidy",
          "configurePreset": "Hosted build with tests + clang-tidy",
          "displayName": "Build and Test on Host with clang-tidy"
        },
        {
          "name": "Doxygen",
          "configurePreset": "Doxygen",
          "displayName": "Generate UNIMOC Doxygen documentation",
          "targets": ["doxygen-docs"]
        }
    ],
    "testPresets": [
      {
        "name": "Hosted Test",
        "configurePreset": "Hosted build with tests",
        "execution": {
          "jobs": 4
        }
      },
      {
        "name": "Hosted Test + clang-tidy",
        "configurePreset": "Hosted build with tests + clang-tidy",
        "execution": {
          "jobs": 4
        }
      }
    ],
    "workflowPresets": [
      {
        "name": "Hosted configure, build and test",
        "displayName": "Hosted configure, build and test",
        "description": "Configure, build and run tests on the host",
        "steps": [
          {
            "type": "configure",
            "name": "Hosted build with tests"
          },
          {
            "type": "build",
            "name": "Hosted build with tests"
          },
          {
            "type": "test",
            "name": "Hosted Test"
          }
        ]
      },
      {
        "name": "Hosted configure, build and test + clang tidy",
        "displayName": "Hosted configure, build and test + clang tidy",
        "description": "Configure, build, run tests, and execute clang-tidy on the host",
        "steps": [
          {
            "type": "configure",
            "name": "Hosted build with tests + clang-tidy"
          },
          {
            "type": "build",
            "name": "Hosted build with tests + clang-tidy"
          },
          {
            "type": "test",
            "name": "Hosted Test + clang-tidy"
          }
        ]
      },
      {
        "name": "BatteryCaseController Debug build",
        "displayName": "BatteryCaseController Debug build",
        "description": "Configure and build Debug firmware for STM32G473 using ARM GCC toolchain for Battery Case Controller",
        "steps": [
          {
            "type": "configure",
            "name": "BatteryCaseController Debug"
          },
          {
            "type": "build",
            "name": "BatteryCaseController Debug"
          }
        ]
      },
      {
        "name": "BatteryCaseController Release build",
        "displayName": "BatteryCaseController Release build",
        "description": "Configure and build Release firmware for STM32G473 using ARM GCC toolchain for Battery Case Controller",
        "steps": [
          {
            "type": "configure",
            "name": "BatteryCaseController Release"
          },
          {
            "type": "build",
            "name": "BatteryCaseController Release"
          }
        ]
      },
      {
        "name": "Generate Doxygen documentation",
        "displayName": "Generate Doxygen documentation",
        "description": "Configure and generate documentation for UNIMOC-owned C++ code",
        "steps": [
          {
            "type": "configure",
            "name": "Doxygen"
          },
          {
            "type": "build",
            "name": "Doxygen"
          }
        ]
      }
    ]
  }
