CONFIG_GPIO=y
CONFIG_ARM_MPU=y
CONFIG_HW_STACK_PROTECTION=y

# Console and log over SEGGER RTT. The application moves the console to USB
# CDC ACM (app/boards/bcc.conf); tests keep RTT.
CONFIG_CONSOLE=y
CONFIG_UART_CONSOLE=n
CONFIG_USE_SEGGER_RTT=y
CONFIG_RTT_CONSOLE=y
CONFIG_FPU=y

CONFIG_ZERO_LATENCY_IRQS=y
CONFIG_CLOCK_CONTROL=y
CONFIG_PINCTRL=y

# Link into the 256 KB code partition (flash bank 1) only: an image that grows
# into bank 2 fails to link instead of losing read while write for the
# settings partition.
CONFIG_USE_DT_CODE_PARTITION=y
