/*
 * UNIMOC Jacobi: 36 V / 45 A drive, STM32H743VIT6 (LQFP100, 2 MB flash).
 *
 * The H7 redesign of the hardware_4850 logic board with its own power board
 * (docs/drive4850_h7_plan.md, schematic in Tecnologic/unimoc_jacobi), without
 * the fourth half bridge. Only the clock (20 MHz HSE) follows the drawn
 * schematic yet; the other pins follow the older pin proposal of the plan and
 * differ from the schematic (TODO.md, "Jacobi devicetree to the schematic").
 * Not run on hardware.
 *
 * Pin and peripheral assignment of the power stage lives in the foc0 node
 * below; the platform (hardware/zephyr_stm32h7) derives timer, ADCs, pins and
 * interrupts from it.
 *
 * SPDX-License-Identifier: GPL-3.0-or-later
 */

/dts-v1/;
#include <st/h7/stm32h743Xi.dtsi>
#include <st/h7/stm32h743vitx-pinctrl.dtsi>

/ {
	model = "UNIMOC Jacobi";
	compatible = "unimoc,jacobi";

	chosen {
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
		zephyr,dtcm = &dtcm;
		zephyr,itcm = &itcm; /* hot path, hardware/zephyr_stm32h7/hot_path_itcm.ld */
		zephyr,code-partition = &slot0_partition;
		zephyr,canbus = &fdcan1;
	};

	/* The status LEDs of hardware/status_leds.hpp. */
	aliases {
		unimoc-led-run = &led_run;
		unimoc-led-pwm = &led_pwm;
		unimoc-led-error = &led_error;
	};

	/*
	 * Status LEDs LED_RUN PE0, LED_ERROR PE1, LED_MODE PE2, LED_PWM PE3
	 * (schematic, interfaces sheet), active high.
	 */
	leds {
		compatible = "gpio-leds";
		led_run: led-run {
			gpios = <&gpioe 0 GPIO_ACTIVE_HIGH>;
			label = "RUN";
		};
		led_error: led-error {
			gpios = <&gpioe 1 GPIO_ACTIVE_HIGH>;
			label = "ERROR";
		};
		led_mode: led-mode {
			gpios = <&gpioe 2 GPIO_ACTIVE_HIGH>;
			label = "MODE";
		};
		led_pwm: led-pwm {
			gpios = <&gpioe 3 GPIO_ACTIVE_HIGH>;
			label = "PWM";
		};
	};

	/*
	 * Three-phase power stage on the Jacobi power board: NCEP6080AG (60 V),
	 * two in parallel per switch, LM5109B gate drivers, one 0.5 mOhm shunt
	 * with an INA240A1 per phase, 47k / 2k2 dividers for Va, Vb, Vc and Vdc
	 * (schematic in Tecnologic/unimoc_jacobi, docs/h743_logic_board.md).
	 *
	 * TIM1 generates centre-aligned PWM on CH1..CH3 (PA8..PA10) and
	 * CH1N..CH3N (PB13..PB15). TRGO2 (rising OC4REF / OC6REF) starts the
	 * injected sequences of ADC1..ADC3 at the same instant. The end of the
	 * ADC1 sequence is the sample interrupt (zero latency), the TIM1 update
	 * vector the observer interrupt. ADC1 has the longest sequence (both
	 * temperatures are on ADC1-only pins), so ADC2 and ADC3 are done by then.
	 */
	foc0: foc-power-stage {
		compatible = "unimoc,foc-stm32h7";
		status = "okay";

		timer = <&timers1>;

		/*
		 * The Jacobi power stage is designed for 200 ns (schematic, phase
		 * sheet). 1 us until 200 ns is checked on the scope.
		 */
		dead-time-ns = <1000>;

		/* Front end: 0.5 mOhm shunt with INA240A1 (+-160 A), 47k / 2k2 dividers (73.8 V). */
		shunt-nano-ohm = <500000>;
		current-amplifier-gain = <20>;
		voltage-divider-ohms = <47000 2200>;
		/* Trip 120 A (rating 120 to 130 A), 100 A peak phase current. */
		max-phase-current-amps = <120>;
		max-motor-current-amps = <100>;
		battery-current-amps = <45 20>;
		/* 60 V FETs, 36 V systems up to 44 V: derate 45 V, trip 48 V, at most 50 V. */
		dc-link-millivolts = <45000 48000 50000>;

		/*
		 * Gate driver supply +12P: 10k / 2k2 (R109/R110) at the drivers, on
		 * PC5 (V12P_SNS). The LM5109B undervoltage lockout is at about 6.7 V;
		 * the NCEP6080AG is specified at 10 V gate drive (the high side gets
		 * +12P less the bootstrap diode), so engage from 10.5 V, trip below 10 V.
		 */
		gate-supply-divider-ohms = <10000 2200>;
		gate-supply-millivolts = <10000 10500>;

		pinctrl-0 = <&tim1_ch1_pa8 &tim1_ch1n_pb13
			     &tim1_ch2_pa9 &tim1_ch2n_pb14
			     &tim1_ch3_pa10 &tim1_ch3n_pb15
			     &tim1_bkin_pe15
			     &analog_pa2 &analog_pb1 &analog_pa0 &analog_pa1
			     &analog_pa3 &analog_pb0 &analog_pc5 &analog_pc4
			     &analog_pc2_c &analog_pc3_c &analog_pc1 &analog_pc0>;
		pinctrl-names = "default";

		/*
		 * Injected sequences in this order, the phase current first on each
		 * ADC. Vdc (PC1) is on ADC3, which reaches it like ADC1 and ADC2, so
		 * ADC2 has room for +12P and the brake lever (ADC1/2-only pins).
		 * Accelerator and brake lever: J601, sensors on +3.3VADC through
		 * 11k / 100n (AIN_ACC, AIN_DCC), 0 V to the ADC reference.
		 */
		io-channels = <&adc1 14>, <&adc1 5>, <&adc1 16>, <&adc1 17>, /* PA2 ia, PB1 va, PA0, PA1   */
			      <&adc2 15>, <&adc2 9>, <&adc2 8>, <&adc2 4>,    /* PA3 ib, PB0 vb, PC5, PC4   */
			      <&adc3 0>, <&adc3 1>, <&adc3 11>, <&adc3 10>;   /* PC2_C ic, PC3_C vc, PC1, PC0 */
		io-channel-names = "ia", "va", "motor-temperature", "bridge-temperature",
				   "ib", "vb", "gate-supply", "brake",
				   "ic", "vc", "vdc", "accelerator";

		/*
		 * ADC clock cycles at 30 MHz (pll2_p 120 MHz / 4). Currents and phase
		 * voltages through 220R / 2n2, Vdc and +12P through 4k7 / 10n, the
		 * accelerator and brake through 11k / 100n: short, the filter capacitors
		 * charge the sample capacitor. NTCs: longer. ADC1 stays the longest
		 * sequence (84 against 52 cycles).
		 */
		sample-times = "2.5", "16.5", "32.5", "32.5",
			       "2.5", "16.5", "16.5", "16.5",
			       "2.5", "16.5", "16.5", "16.5";
	};

	/*
	 * Further board signals, named after the nets of the schematic.
	 */
	zephyr,user {
		/*
		 * PWM_EN: the optocoupler U1102 (12 to 40 V on J501) on PE15, which
		 * is also TIM1_BKIN: low breaks the outputs in hardware. There is no
		 * separate gate driver enable.
		 */
		break-gpios = <&gpioe 15 GPIO_ACTIVE_HIGH>;
		/* Hall sensors A, B, C (TIM4 CH1..CH3 for a later capture). */
		hall-gpios = <&gpiod 12 GPIO_ACTIVE_HIGH>,
			     <&gpiod 13 GPIO_ACTIVE_HIGH>,
			     <&gpiod 14 GPIO_ACTIVE_HIGH>;
		/* TCAN334 STB on PD2: high = standby. Driven low by the Cyphal platform. */
		can-standby-gpios = <&gpiod 2 GPIO_ACTIVE_HIGH>;
		/*
		 * PWR_DET on PE4 (10k pull-up R612, GND on the power board): low while
		 * the power board is plugged in. Without it the drive does not engage.
		 */
		power-board-gpios = <&gpioe 4 GPIO_ACTIVE_LOW>;
	};
};

/* Break input: open means break, so pull it down. */
&tim1_bkin_pe15 {
	bias-pull-down;
};

/* Used by the foc0 driver: enables the timer and its IRQ vectors. */
&timers1 {
	status = "okay";
};

/*
 * The foc0 driver programs ADC1..3 itself; the Zephyr ADC driver would claim
 * them. The nodes stay in the tree for the registers, clocks and IRQs.
 */
&adc1 {
	status = "disabled";
};

&adc2 {
	status = "disabled";
};

&adc3 {
	status = "disabled";
};

/* The H743 has no SMPS: the core supply comes from the LDO (VCAP pins). */
&pwr {
	power-supply = "ldo";
};

&clk_hsi48 {
	status = "okay";
};

/* HSE: 20 MHz oscillator X601 on PH0, bypass mode (unimoc_jacobi, mcu sheet). */
&clk_hse {
	clock-frequency = <DT_FREQ_M(20)>;
	hse-bypass;
	status = "okay";
};

/*
 * 20 MHz / 5 * 200 / 2 = 400 MHz core (silicon rev. Y limit; rev. V would
 * allow 480 MHz), HCLK 200 MHz, APB 100 MHz, TIM1 200 MHz.
 */
&pll {
	div-m = <5>;
	mul-n = <200>;
	div-p = <2>;
	div-q = <2>;
	div-r = <2>;
	clocks = <&clk_hse>;
	status = "okay";
};

/* 20 MHz / 10 * 120 = 240 MHz: P 120 MHz for the ADCs, Q 80 MHz for FDCAN1. */
&pll2 {
	div-m = <10>;
	mul-n = <120>;
	div-p = <2>;
	div-q = <3>;
	div-r = <2>;
	clocks = <&clk_hse>;
	status = "okay";
};

&rcc {
	clocks = <&pll>;
	clock-frequency = <DT_FREQ_M(400)>;
	d1cpre = <1>;
	hpre = <2>;
	d1ppre = <2>;
	d2ppre1 = <2>;
	d2ppre2 = <2>;
	d3ppre = <2>;
};

&rng {
	status = "okay";
};

/*
 * CAN: TCAN334 on FDCAN1 (PD0 RX, PD1 TX). The transceiver handles CAN FD
 * data rates, but the bus runs 1 Mbit/s in both phases like the other nodes
 * (app/boards/unimoc_jacobi.conf turns the bit rate switch off).
 */
&fdcan1 {
	pinctrl-0 = <&fdcan1_rx_pd0 &fdcan1_tx_pd1>;
	pinctrl-names = "default";
	clocks = <&rcc STM32_CLOCK(APB1_2, 8)>,
		 <&rcc STM32_SRC_PLL2_Q FDCAN_SEL(2)>;
	bitrate = <1000000>;
	sample-point = <875>;
	bitrate-data = <1000000>;
	sample-point-data = <875>;
	status = "okay";
};

/*
 * Flash, 2 x 1 MB banks with 128 KB sectors: the image in bank 1, the DFU
 * slot and the settings in bank 2, so that a settings erase does not stall
 * the code.
 */
&flash0 {
	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		slot0_partition: partition@0 {
			label = "image-0";
			reg = <0x00000000 DT_SIZE_K(1024)>;
		};

		slot1_partition: partition@100000 {
			label = "image-1";
			reg = <0x00100000 DT_SIZE_K(768)>;
		};

		/* Settings: ZMS on two sectors. */
		storage_partition: partition@1c0000 {
			label = "storage";
			reg = <0x001c0000 DT_SIZE_K(256)>;
		};
	};
};
