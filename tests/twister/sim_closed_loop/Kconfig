mainmenu "UNIMOC"

choice UNIMOC_PLATFORM
	prompt "UNIMOC hardware platform"
	default UNIMOC_PLATFORM_BCC if BOARD_BCC
	default UNIMOC_PLATFORM_SIM if BOARD_NATIVE_SIM
	help
	  Selects which hardware layer (hardware/zephyr_*) the build compiles.
	  The choice follows the board; it is never a preprocessor switch.

config UNIMOC_PLATFORM_BCC
	bool "Battery case controller (STM32G473)"
	depends on BOARD_BCC

config UNIMOC_PLATFORM_SIM
	bool "Simulation on native_sim"
	depends on BOARD_NATIVE_SIM

endchoice

module = UNIMOC
module-str = UNIMOC
source "subsys/logging/Kconfig.template.log_config"

source "Kconfig.zephyr"
